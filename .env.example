# Server Settings
PORT=3000
BASE_URL=https://your-domain.ngrok-free.app

# LINE Messaging API Credentials
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# LINE LIFF App IDs
LIFF_NOTES_ID=your_liff_notes_id
LIFF_DISPATCH_ID=your_liff_dispatch_id
LIFF_ADMIN_ID=your_liff_admin_id
LIFF_CALENDAR_ID=your_liff_calendar_id

# ----------------------------------------------------
# AI Provider Settings
# ----------------------------------------------------
# Priority list of AI providers (comma-separated). The first configured one is
# the primary; the rest are fallbacks used only when the primary keeps failing
# on transient errors (rate limit / 5xx / network). Supported: gemini, ollama, openai.
#   "gemini"          -> Gemini only (default)
#   "gemini,ollama"   -> Gemini primary, self-hosted Gemma fallback
#   "openai,gemini"   -> self-hosted OpenAI-compatible (e.g. Qwen-VL) primary, Gemini fallback
AI_PROVIDER_ORDER=gemini

# Retry/backoff on transient errors (per provider, before falling back)
AI_MAX_RETRIES=3
AI_RETRY_BASE_MS=1000
AI_RETRY_CAP_MS=8000

# Google GenAI (gemini provider)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-flash

# Self-hosted local model (ollama provider). Point this at an Ollama server
# running e.g. gemma3n:e4b, exposed via a public HTTPS endpoint / Cloudflare
# Tunnel so the backend can reach it. Leave OLLAMA_BASE_URL blank to disable.
OLLAMA_BASE_URL=
OLLAMA_MODEL_NAME=gemma3n:e4b

# Self-hosted OpenAI-compatible model (openai provider) — e.g. vLLM / LM Studio /
# llama.cpp serving a Qwen*-VL vision model. OPENAI_BASE_URL is the API base that
# exposes /chat/completions (e.g. https://your-tunnel-host/v1). For a model on
# your local machine, expose it via Cloudflare Tunnel so the Worker can reach it.
# OPENAI_API_KEY is optional (many local servers ignore it). Leave blank to disable.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=qwen2.5-vl

# Database Settings
# DB_TYPE: 'local' for JSON files or 'firestore' for Google Cloud Firestore
DB_TYPE=local

# Firebase Service Account Credentials (Required only if DB_TYPE=firestore)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase Credentials (Required only if DB_TYPE=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
