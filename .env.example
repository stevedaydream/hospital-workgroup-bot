# Server Settings
PORT=3000
BASE_URL=https://your-domain.ngrok-free.app

# LINE Messaging API Credentials
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# LINE LIFF App IDs
LIFF_NOTES_ID=your_liff_notes_id
LIFF_DISPATCH_ID=your_liff_dispatch_id
LIFF_ADMIN_ID=your_liff_admin_id
LIFF_CALENDAR_ID=your_liff_calendar_id

# Google GenAI Settings
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-flash

# Database Settings
# DB_TYPE: 'local' for JSON files or 'firestore' for Google Cloud Firestore
DB_TYPE=local

# Firebase Service Account Credentials (Required only if DB_TYPE=firestore)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase Credentials (Required only if DB_TYPE=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
