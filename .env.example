# ----------------------------------------------------
# Server
# ----------------------------------------------------
PORT=3000
# Public HTTPS base URL. LINE requires HTTPS for the webhook, the LIFF
# endpoints and for the images pushed at 07:30.
BASE_URL=https://your-subdomain.duckdns.org

# ----------------------------------------------------
# LINE Messaging API
# ----------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# ----------------------------------------------------
# LINE Login / LIFF
# ----------------------------------------------------
# Channel ID of the LINE Login channel that owns the LIFF apps. ID tokens
# presented by the LIFF pages must carry this value as their audience --
# without it every authenticated /api/* endpoint rejects requests.
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id

LIFF_NOTES_ID=your_liff_notes_id
LIFF_DISPATCH_ID=your_liff_dispatch_id
LIFF_ADMIN_ID=your_liff_admin_id
LIFF_CALENDAR_ID=your_liff_calendar_id

# Shared secret for operations that push to every group (/api/test-cron).
ADMIN_API_KEY=generate_a_long_random_string

# Local development escape hatch. NEVER set this on the server: it disables
# authentication on every /api/* endpoint.
# AUTH_DISABLED=true

# ----------------------------------------------------
# AI engines
# ----------------------------------------------------
# auto  : local first, Gemini as automatic fallback, mock if neither exists
# local : local only (fails loudly instead of reaching the cloud)
# gemini: cloud only
# mock  : no inference at all, for offline development
AI_PROVIDER=auto

# llama.cpp server running Gemma 4 E4B with its mmproj projector
LLAMA_SERVER_URL=http://127.0.0.1:8080
# Fall back to the cloud after this long. Set it from scripts/benchmark.mjs
# rather than guessing; 6 minutes is the pre-measurement default.
LOCAL_INFERENCE_TIMEOUT_MS=360000
LOCAL_MAX_TOKENS=2048

# Cloud fallback. Leaving this unset makes local failures fatal instead of
# silently sending ward photographs to Google.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-flash

# ----------------------------------------------------
# Image preprocessing
# ----------------------------------------------------
# Prefill time scales with resolution, but these are photos of dense Excel
# grids where the names are already marginal -- do not lower this without
# re-running the benchmark.
IMAGE_MAX_EDGE=1536
IMAGE_JPEG_QUALITY=85

# ----------------------------------------------------
# Dispatch confirmation
# ----------------------------------------------------
# How long a recognised case table waits for someone to tap "confirm" before
# it adopts the matched result on its own. A confirmation step that can expire
# silently would turn a safety check into a missed 07:30 dispatch.
CONFIRM_GRACE_HOURS=2

# ----------------------------------------------------
# Database (SQLite, single file)
# ----------------------------------------------------
SQLITE_PATH=./data/hospital.db

# ----------------------------------------------------
# One-off migration from the previous Supabase project
# (only needed when running `npm run migrate:supabase`)
# ----------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
