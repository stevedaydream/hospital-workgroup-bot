# ----------------------------------------------------
# Server
# ----------------------------------------------------
PORT=3000
# Listen address; public traffic comes through Tailscale Funnel or Caddy.
# HOST=127.0.0.1
# Public HTTPS base URL. LINE requires HTTPS for the webhook, the LIFF
# endpoints and for the images pushed at 07:30.
BASE_URL=https://your-subdomain.duckdns.org

# ----------------------------------------------------
# LINE Messaging API
# ----------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# ----------------------------------------------------
# LINE Login / LIFF
# ----------------------------------------------------
# Channel ID of the LINE Login channel that owns the LIFF apps. ID tokens
# presented by the LIFF pages must carry this value as their audience --
# without it every authenticated /api/* endpoint rejects requests.
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id

LIFF_NOTES_ID=your_liff_notes_id
LIFF_DISPATCH_ID=your_liff_dispatch_id
LIFF_ADMIN_ID=your_liff_admin_id
LIFF_CALENDAR_ID=your_liff_calendar_id
# Optional: a LIFF app for 出國登記 (endpoint .../liff/travel). Left empty, the
# page opens through the calendar app instead.
# LIFF_TRAVEL_ID=

# Shared secret for operations that push to every group (/api/test-cron).
ADMIN_API_KEY=generate_a_long_random_string

# Local development escape hatch. NEVER set this on the server: it disables
# authentication on every /api/* endpoint.
# AUTH_DISABLED=true

# ----------------------------------------------------
# AI
# ----------------------------------------------------
# Port Monitor (43922): starts a model that is not loaded, by project priority.
# Create a project key for this bot in Port Monitor (desktop → 取得連線設定).
# Leave empty to skip Port Monitor; when it is not running the gateway is used.
PORT_MONITOR_API_KEY=
# PORT_MONITOR_BASE_URL=http://127.0.0.1:43922
# PORT_MONITOR_TIMEOUT_MS=600000
# Model switching uses the local Port Monitor control API (43920).
# Defaults to %LOCALAPPDATA%/com.stevedaydream.portmonitor/settings.json.
# PORT_MONITOR_CONTROL_SETTINGS_PATH=

# Local models through the Local AI Gateway (C:\AI\gateway). Tried in order:
# Use Qwen3.6 directly to avoid waiting for a Strata cold start.
# Leave LOCAL_AI_BASE_URL empty to use Gemini only.
LOCAL_AI_BASE_URL=http://127.0.0.1:4000
LOCAL_AI_MODELS=qwen3.6
# LOCAL_AI_API_KEY=        # only if the gateway sets AI_GATEWAY_KEY
# LOCAL_AI_TIMEOUT_MS=240000

# Cloud fallback when Strata is unreachable (the group is told photos went to the cloud).
# Left as placeholder, a Strata failure is reported as an error instead of mock data.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-flash

# ----------------------------------------------------
# Database (SQLite, single file)
# ----------------------------------------------------
SQLITE_PATH=./data/hospital.db

# ----------------------------------------------------
# One-off migration from the previous Supabase project
# (only needed when running `npm run migrate:supabase`)
# ----------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key

# ----------------------------------------------------
# MedBase scheduling integration (medbase-mobile /api/bot)
# ----------------------------------------------------
# Leave MEDBASE_API_KEY empty to turn the integration off.
# MEDBASE_API_KEY must equal BOT_API_KEY on the Vercel project medbase-mobile;
# MEDBASE_NOTIFY_SECRET must equal its BOT_NOTIFY_SECRET (swap notices are
# HMAC-signed with it and POSTed to ${BASE_URL}/integrations/medbase).
MEDBASE_API_URL=https://medbase-mobile.vercel.app
MEDBASE_API_KEY=
MEDBASE_NOTIFY_SECRET=
