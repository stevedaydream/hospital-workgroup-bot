# ----------------------------------------------------
# Server
# ----------------------------------------------------
PORT=3000
# Public HTTPS base URL. LINE requires HTTPS for the webhook, the LIFF
# endpoints and for the images pushed at 07:30.
BASE_URL=https://your-subdomain.duckdns.org

# ----------------------------------------------------
# LINE Messaging API
# ----------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# ----------------------------------------------------
# LINE Login / LIFF
# ----------------------------------------------------
# Channel ID of the LINE Login channel that owns the LIFF apps. ID tokens
# presented by the LIFF pages must carry this value as their audience --
# without it every authenticated /api/* endpoint rejects requests.
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id

LIFF_NOTES_ID=your_liff_notes_id
LIFF_DISPATCH_ID=your_liff_dispatch_id
LIFF_ADMIN_ID=your_liff_admin_id
LIFF_CALENDAR_ID=your_liff_calendar_id

# Shared secret for operations that push to every group (/api/test-cron).
ADMIN_API_KEY=generate_a_long_random_string

# Local development escape hatch. NEVER set this on the server: it disables
# authentication on every /api/* endpoint.
# AUTH_DISABLED=true

# ----------------------------------------------------
# AI
# ----------------------------------------------------
# Strata on the home PC, reached over Tailscale. Leave STRATA_BASE_URL empty
# to use Gemini only. On the PC: tailscale serve --bg --https=8444 http://127.0.0.1:8080
STRATA_BASE_URL=https://steve.tailb73635.ts.net:8444
# Optional: Strata serves whichever model is loaded when this is empty.
# STRATA_MODEL=
# STRATA_API_KEY=
# STRATA_TIMEOUT_MS=240000

# Cloud fallback when Strata is unreachable (the group is told photos went to the cloud).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-flash

# ----------------------------------------------------
# Database (SQLite, single file)
# ----------------------------------------------------
SQLITE_PATH=./data/hospital.db

# ----------------------------------------------------
# One-off migration from the previous Supabase project
# (only needed when running `npm run migrate:supabase`)
# ----------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
